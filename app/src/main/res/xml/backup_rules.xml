<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 24-30 (prod). Ignored on API 31+, which uses
    data_extraction_rules.xml. Only the Room database and the avatar pictures
    are backed up. The dev flavor overrides this file to exclude everything
    (see src/dev/res/xml).
-->
<full-backup-content>
    <include domain="database" path="betcoin.db" />
    <include domain="database" path="betcoin.db-wal" />
    <include domain="database" path="betcoin.db-shm" />
    <include domain="file" path="avatars/" />
</full-backup-content>
